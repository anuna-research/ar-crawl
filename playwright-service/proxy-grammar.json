{
  "description": "Proxy input BNF; IPv6/IPv4 productions follow RFC 3986 section 3.2.2.",
  "entries": ["endpoint", "wire-endpoint", "bypass-host", "bypass-list"],
  "maxLengths": {"endpoint": 4096, "wire-endpoint": 269, "bypass-host": 254, "bypass-list": 8192},
  "authorityTailLimit": 269,
  "classes": {"alpha": "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ", "digit": "0123456789", "hexdig": "0123456789abcdefABCDEF", "nonzero": "123456789", "zero-four": "01234", "zero-five": "012345", "unreserved-punctuation": "-._~", "sub-delim": "!$&'()*+,;="},
  "rules": {
    "endpoint": [["scheme", {"literal": "://"}, "authority", {"literal": ":"}, "port", "slash"]],
    "wire-endpoint": [["scheme", {"literal": "://"}, "host", {"literal": ":"}, "port", "slash"]],
    "scheme": [[{"literal": "http"}], [{"literal": "socks5"}]],
    "slash": [[], [{"literal": "/"}]],
    "authority": [["credentials", "host"], ["host"]],
    "credentials": [["username", {"literal": ":"}, "password", {"literal": "@"}]],
    "username": [[], ["username", "user-char"]],
    "password": [[], ["password", "password-char"]],
    "password-char": [["user-char"], [{"literal": ":"}]],
    "user-char": [["unreserved"], ["sub-delim"], ["pct-encoded"]],
    "pct-encoded": [[{"literal": "%"}, "hexdig", "hexdig"]],
    "unreserved": [["alnum"], ["unreserved-punctuation"]],
    "alnum": [["alpha"], ["digit"]],
    "host": [["dns-name"], [{"literal": "["}, "ipv6", {"literal": "]"}]],
    "dns-name": [["dns-label"], ["dns-name", {"literal": "."}, "dns-label"]],
    "dns-label": [["alnum"], ["alnum", "label-middle", "alnum"]],
    "label-middle": [[], ["label-middle", "label-char"]],
    "label-char": [["alnum"], [{"literal": "-"}]],
    "port": [["digit"], ["port", "digit"]],
    "bypass-host": [["dns-name"], [{"literal": "."}, "dns-name"]],
    "bypass-list": [[], ["bypass-nonempty"]],
    "bypass-nonempty": [["bypass-host"], ["bypass-nonempty", {"literal": ","}, "bypass-host"]],
    "h16": [["hexdig"], ["hexdig", "hexdig"], ["hexdig", "hexdig", "hexdig"], ["hexdig", "hexdig", "hexdig", "hexdig"]],
    "ls32": [["h16", {"literal": ":"}, "h16"], ["ipv4"]],
    "ipv4": [["dec-octet", {"literal": "."}, "dec-octet", {"literal": "."}, "dec-octet", {"literal": "."}, "dec-octet"]],
    "dec-octet": [["digit"], ["nonzero", "digit"], [{"literal": "1"}, "digit", "digit"], [{"literal": "2"}, "zero-four", "digit"], [{"literal": "25"}, "zero-five"]],
    "prefix-1": [[], ["h16"]],
    "prefix-2": [[], ["h16"], ["h16", {"literal": ":"}, "h16"]],
    "prefix-3": [[], ["h16"], ["h16", {"literal": ":"}, "h16"], ["h16", {"literal": ":"}, "h16", {"literal": ":"}, "h16"]],
    "prefix-4": [[], ["h16"], ["h16", {"literal": ":"}, "h16"], ["h16", {"literal": ":"}, "h16", {"literal": ":"}, "h16"], ["h16", {"literal": ":"}, "h16", {"literal": ":"}, "h16", {"literal": ":"}, "h16"]],
    "prefix-5": [[], ["h16"], ["h16", {"literal": ":"}, "h16"], ["h16", {"literal": ":"}, "h16", {"literal": ":"}, "h16"], ["h16", {"literal": ":"}, "h16", {"literal": ":"}, "h16", {"literal": ":"}, "h16"], ["h16", {"literal": ":"}, "h16", {"literal": ":"}, "h16", {"literal": ":"}, "h16", {"literal": ":"}, "h16"]],
    "prefix-6": [[], ["h16"], ["h16", {"literal": ":"}, "h16"], ["h16", {"literal": ":"}, "h16", {"literal": ":"}, "h16"], ["h16", {"literal": ":"}, "h16", {"literal": ":"}, "h16", {"literal": ":"}, "h16"], ["h16", {"literal": ":"}, "h16", {"literal": ":"}, "h16", {"literal": ":"}, "h16", {"literal": ":"}, "h16"], ["h16", {"literal": ":"}, "h16", {"literal": ":"}, "h16", {"literal": ":"}, "h16", {"literal": ":"}, "h16", {"literal": ":"}, "h16"]],
    "prefix-7": [[], ["h16"], ["h16", {"literal": ":"}, "h16"], ["h16", {"literal": ":"}, "h16", {"literal": ":"}, "h16"], ["h16", {"literal": ":"}, "h16", {"literal": ":"}, "h16", {"literal": ":"}, "h16"], ["h16", {"literal": ":"}, "h16", {"literal": ":"}, "h16", {"literal": ":"}, "h16", {"literal": ":"}, "h16"], ["h16", {"literal": ":"}, "h16", {"literal": ":"}, "h16", {"literal": ":"}, "h16", {"literal": ":"}, "h16", {"literal": ":"}, "h16"], ["h16", {"literal": ":"}, "h16", {"literal": ":"}, "h16", {"literal": ":"}, "h16", {"literal": ":"}, "h16", {"literal": ":"}, "h16", {"literal": ":"}, "h16"]],
    "ipv6": [["h16", {"literal": ":"}, "h16", {"literal": ":"}, "h16", {"literal": ":"}, "h16", {"literal": ":"}, "h16", {"literal": ":"}, "h16", {"literal": ":"}, "ls32"], [{"literal": "::"}, "h16", {"literal": ":"}, "h16", {"literal": ":"}, "h16", {"literal": ":"}, "h16", {"literal": ":"}, "h16", {"literal": ":"}, "ls32"], ["prefix-1", {"literal": "::"}, "h16", {"literal": ":"}, "h16", {"literal": ":"}, "h16", {"literal": ":"}, "h16", {"literal": ":"}, "ls32"], ["prefix-2", {"literal": "::"}, "h16", {"literal": ":"}, "h16", {"literal": ":"}, "h16", {"literal": ":"}, "ls32"], ["prefix-3", {"literal": "::"}, "h16", {"literal": ":"}, "h16", {"literal": ":"}, "ls32"], ["prefix-4", {"literal": "::"}, "h16", {"literal": ":"}, "ls32"], ["prefix-5", {"literal": "::"}, "ls32"], ["prefix-6", {"literal": "::"}, "h16"], ["prefix-7", {"literal": "::"}]]
  }
}
