(predicate task-description ((id symbol) (text symbol)) (kind state))
(predicate task-acceptance ((id symbol) (text symbol)) (kind state))
(given (task config))
(given (task-description config "Implement recognised proxy configuration and atomic pool selection"))
(given (task-acceptance config "TEST-101 TEST-102 TEST-106 pass"))
(given (no-deps config))
(normally r-ready-config (and (task config) (no-deps config)) (ready config))
(meta r-ready-config (source "SPEC-001-proxy-support#REQ-101"))
(always r-complete-config (verified config) (completed config))
(meta r-complete-config (source "SPEC-001-proxy-support#Verification"))
(given (task transport))
(given (task-description transport "Route direct/browser/robots fetches and reject implicit direct fallback"))
(given (task-acceptance transport "TEST-103 TEST-104 TEST-105 TEST-106 pass"))
(normally r-ready-transport (and (task transport) (completed config)) (ready transport))
(meta r-ready-transport (source "SPEC-001-proxy-support#REQ-103"))
(always r-complete-transport (verified transport) (completed transport))
(meta r-complete-transport (source "SPEC-001-proxy-support#Verification"))
(given (task acceptance))
(given (task-description acceptance "Run regression and mutation checks and obtain independent review"))
(given (task-acceptance acceptance "TEST-101 through TEST-106 evidence and review recorded"))
(normally r-ready-acceptance (and (task acceptance) (completed transport)) (ready acceptance))
(meta r-ready-acceptance (source "SPEC-001-proxy-support#REQ-104"))
(always r-complete-acceptance (verified acceptance) (completed acceptance))
(meta r-complete-acceptance (source "SPEC-001-proxy-support#Verification"))
(always r-done (and (completed config) (completed transport) (completed acceptance)) (completed proxy-support))
(meta r-done (source "SPEC-001-proxy-support#Verification"))
