(predicate task-description ((id symbol) (text symbol)) (kind state))
(predicate task-acceptance ((id symbol) (text symbol)) (kind state))
(given (task grammar))
(given (no-deps grammar))
(given (task-description grammar "Replace handwritten recognisers with shared BNF and generated parsers"))
(given (task-acceptance grammar "TEST-107 TEST-108 and inherited transport checks pass; independent review recorded"))
