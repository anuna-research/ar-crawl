# AR-Crawl Environment Variables
# Copy this file to .env and fill in your actual API keys

# ===================
# Service API Keys
# ===================

# FireCrawl API Key - Get from https://firecrawl.dev
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# ScrapingBee API Key - Get from https://scrapingbee.com
SCRAPINGBEE_API_KEY=your_scrapingbee_api_key_here

# Browserless API Key - Get from https://browserless.io
BROWSERLESS_API_KEY=your_browserless_api_key_here

# ScraperAPI API Key - Get from https://scraperapi.com
SCRAPERAPI_API_KEY=your_scraperapi_api_key_here

# ===================
# Crawler Configuration
# ===================

# Logging level: debug, info, warning, error
LOG_LEVEL=info

# Maximum number of concurrent crawling jobs
MAX_CONCURRENT_JOBS=10

# Rate limiting between requests (milliseconds)
RATE_LIMIT_MS=1000

# Request timeout (milliseconds)
TIMEOUT_MS=30000

# Number of retry attempts for failed requests
RETRY_ATTEMPTS=3

# ===================
# Optional Services
# ===================

# Database connection (if using PostgreSQL storage)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ar_crawl
POSTGRES_USER=ar_crawl
POSTGRES_PASSWORD=ar_crawl_password

# Redis connection (if using Redis for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===================
# Monitoring
# ===================

# Grafana admin password (for monitoring dashboard)
GRAFANA_PASSWORD=admin

# Prometheus metrics endpoint
PROMETHEUS_ENABLED=true

# ===================
# Advanced Configuration
# ===================

# Enable/disable service fallbacks
FALLBACK_ENABLED=true

# Enable monitoring and metrics collection
ENABLE_MONITORING=true

# Output directory for crawled data
OUTPUT_DIR=./output

# Temporary directory for processing
TEMP_DIR=./temp

# Log directory
LOG_DIR=./logs
